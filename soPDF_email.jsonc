{
  // Oggetto facilmente modificabile. Dati passata:
  // run_start, run_end (gg/mm/aaaa), run_duration (HH:MM:SS), total_pdfs, total_pages,
  // ok, ko, rotated, status, error_count. Nei corpi anche {files}.
  "subject": "soPDF - {total_pdfs} PDF, {total_pages} fogli - {status}",
  "subjectOnError": "soPDF - ERRORI: {error_count} - {total_pdfs} PDF elaborati",
  "bodyText": "RIEPILOGO soPDF - {status}\n\nFogli totali: {total_pages}\nFogli OK: {ok}\nFogli KO: {ko}\nPDF elaborati: {total_pdfs}\n\nInizio: {run_start}\nFine: {run_end}\nDurata: {run_duration}\n\nDETTAGLIO PDF (errori prima)\n\n{files}",
  // HTML in file separato, relativo a questo JSONC. Dati protetti con escaping.
  // Blocco per PDF con una riga per foglio in errore: {pdf_blocks}.
  // Colore esito {status_color}. Vecchi blocchi pdf_rows/error_section ancora supportati.
  // In alternativa omettere bodyHtmlFile e usare bodyHtml inline.
  "bodyHtmlFile": "soPDF_email.html",
  // Riga per PDF: file, output_name, started, finished, duration, pages,
  // processed, ok, ko, rotated, status, resumed, errors.
  "fileTemplate": "PDF: {file}\nEsito: {status}\nFogli: {pages} - OK: {ok} - KO: {ko}\nInizio: {started} - Fine: {finished} - Durata: {duration}\nErrori:\n{errors}",
  // Una riga per foglio: error_file, error_page, error_reason.
  // Ordine numerico, massimo 100 errori mostrati per PDF; JSON sempre completo.
  "errorTemplate": "- Foglio {error_page}: {error_reason}\n  Salvato come: {error_file}"
}