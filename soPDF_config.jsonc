{ // soPDF: configurazione dello split e lettura barcode
  "extractor": {                       // Lettore esterno; main.py non viene modificato
    "python": "",                      // Vuoto = stesso Python dell'utilità
    "mainPy": "",                      // Vuoto = main.py accanto all'utilità
    "customer": "UNKNOWN",             // Valore di -customer
    "template": "barcode001",          // Template del lettore con il campo barcode
    "extraArgs": ["-no-ai-bootstrap"], // Argomenti extra prima di -eo
    "timeoutSec": 120                  // Secondi massimi per pagina; oltre = KO
  },
  "paths": {                           // Relativi alla cartella dell'utilità, non al config
    "in_pdf": "in_pdf",                // PDF sorgenti, anche estensione .PDF
    "out_pdf": "out_pdf",              // Pagine OK; sottocartelle solo con out_pdf_dir_separation=true
    "err_pdf": "err_pdf",              // Stessa sottocartella; <cartella>_p<N>.pdf per KO
    "worked_pdf": "worked_pdf",        // Stessa sottocartella; <cartella>.pdf originale archiviato
    "tempDir": "temp_split",           // Job temporanei, stato di ripresa e lock
    "logDir": "logs",                  // Cartella log di testo, nessun DB dell'utilità
    "reportDir": "reports"             // Un JSON persistente per lancio con elaborazioni
  },
  "barcode": {
    "jsonField": "barcode_top",        // Campo di primo livello da usare come nome file
    "validationRegex": "^[sS][0-9]{7}$", // s/S + 7 cifre; solo S: ^S[0-9]{7}$; vuoto/assente = nessun filtro regex
    "invalidValues": ["N/A", ""],      // Valori considerati mancata lettura
    "rotationOnFailureReading": true   // Al primo fallimento ruota la pagina di 180° e rilegge una volta
  },
  "out_pdf_dir_separation": false,     // false: OK tutti in out_pdf, sovrascrive; true: cartelle per sorgente + suffissi
  "onDuplicate": "suffix_n",           // _1, _2, ...; non applicato agli OK in modalità piatta (sovrascrive)
  "minFileAgeSec": 5,                  // Intervallo di stabilità dimensione/data prima del pickup
  "lockStaleMin": 60,                  // Recupera lock vecchi solo se PID locale non più vivo
  "keepTemp": false,                   // true conserva anche i job completati per debug
  "parallel": {
    "maxWorkers": 1                    // Mancante/null/0/1 = sequenziale; >1 = thread + subprocess
  },
  "compression": {                     // Solo dopo lettura OK; originali e KO restano invariati
    "enabled": true,                   // false salta la compressione
    "engine": "raster",                // Render PDFium + PDF/JPEG Pillow; niente programmi esterni
    "dpi": 100,                        // Risoluzione; ridurla diminuisce qualità e peso
    "jpegQuality": 50,                 // Qualità JPEG 1-95
    "grayscale": false,                // true converte in scala di grigi
    "minGainPercent": 10,              // Sotto questa % di risparmio conserva l'originale
    "keepOriginalIfLarger": true,       // Non accetta mai aumento di peso
    "skipIfHasText": true              // Evita raster su pagine con testo selezionabile
  },
  "log": {
    "fileName": "split.log",           // Solo nome file, dentro paths.logDir
    "maxSizeMB": 10,                   // Soglia rotazione in MiB (1024*1024), anche decimale >0
    "backupCount": 5,                  // Storico .1, .2...; 0 tronca senza tenere storico
    "level": "INFO"                    // DEBUG, INFO, WARN, WARNING o ERROR
  },
  "email": {                           // API Brevo HTTPS; nessun allegato
    "enabled": true,                   // false mantiene solo i report locali
    "sendOn": "always",                // always | error | never; niente invio per passata vuota
    "apiKeyEnvVar": "BREV_API_KEY",     // Nome effettivo nel tuo .env; default codice BREVO_API_KEY
    "from": {"name": "soPDF", "email": "consegne@sogesispa.it"},
    "to": ["d.cimarelli@keyfor.it", "f.ortolani@keyfor.it"],     // Destinatari configurabili
    "templateFile": "soPDF_email.jsonc", // Oggetto e corpo; percorso relativo al progetto
    "timeoutSec": 30,
    "retryDays": 7                     // Recupero riepiloghi falliti in un'unica email
  }
}